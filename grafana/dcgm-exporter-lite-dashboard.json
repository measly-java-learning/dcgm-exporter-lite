        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(DCGM_FI_DEV_GPU_UTIL_RATIO{instance=~\"$instance\",gpu=~\"$gpu\"}) * 100",
          "legendFormat": "{{gpu}}",
          "refId": "A",
          "instant": false
